{
  "name": "dsh-lite-memory",
  "version": "0.7.0",
  "description": "DSH 轻量记忆插件:SQLite 条目化记忆(标题/重要程度/来源/内容,增删改查)+ 记忆标题经 systemPrompt.context 动态注入为 durable user-role 快照(全局+当前项目,CRUD 后自动刷新),比静态 section 更省 token;设置页与对话面板双入口,中英双语自动跟随。只做记忆:无日历、无定时任务。",
  "icon": "./assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriusWJ/dsh-lite-memory.git"
  },
  "homepage": "https://github.com/SiriusWJ/dsh-lite-memory#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "sqlite",
    "recall"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./icon": "./assets/icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
